# ============================================================
# AgenticOS — Backend Environment Variables
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenticos

# --- JWT ---
JWT_SECRET=change-me-in-production

# --- LLM Provider ---
# Point directly to any OpenAI-compatible endpoint.
# Examples:
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
#   Anthropic:   https://api.anthropic.com/v1
#   Ollama:      http://localhost:11434/v1
#   Hermes:      http://localhost:18789/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-api-key-here

# --- Qdrant ---
QDRANT_URL=http://localhost:6333

# --- Server ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# --- Logging ---
RUST_LOG=agenticos=debug,tower_http=debug

# --- CORS (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:3001
